<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <!-- Path relatif terhadap folder proyek ini, portable di semua mesin/user -->
    <PublishDir>bin\Publish\win-x64</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>

    <!-- Self-contained single-file: exe hasil publish jalan sendiri di PC user
         TANPA perlu install .NET 8 Desktop Runtime terpisah. Ukuran lebih besar
         (~150MB) tapi ini yang paling masuk akal untuk installer konsumen. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
